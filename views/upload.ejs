<!DOCTYPE html>
<html lang="en">
<head>
  <title>Create New Pin | Pinspire</title>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Cabinet+Grotesk:wght@400;500;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --pink: #FF3CAC; --violet: #784BA0; --blue: #2B86C5;
      --grad1: linear-gradient(135deg, #FF3CAC 0%, #784BA0 50%, #2B86C5 100%);
      --bg: #070710; --text: #f0f0ff; --muted: rgba(240,240,255,0.45);
      --glass: rgba(255, 255, 255, 0.05);
    }

    body {
      font-family: 'Cabinet Grotesk', sans-serif;
      background: var(--bg); color: var(--text);
      margin: 0; min-height: 100vh; overflow-x: hidden;
    }

    /* ── BACKGROUND SCENE ── */
    .bg-scene { position: fixed; inset: 0; z-index: 0; }
    .bg-grid {
      position: absolute; inset: 0;
      background-image: 
        linear-gradient(rgba(255, 60, 172, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 60, 172, 0.05) 1px, transparent 1px),
        linear-gradient(rgba(255, 255, 255, 0.02) 2px, transparent 2px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.02) 2px, transparent 2px);
      background-size: 30px 30px, 30px 30px, 150px 150px, 150px 150px;
    }

    .container {
      position: relative; z-index: 1;
      max-width: 1000px; margin: 60px auto; padding: 20px;
    }

    .upload-card {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(25px); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 32px; padding: 40px;
      display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px;
    }

    /* ── PREVIEW ZONE ── */
    .preview-zone {
      background: rgba(0, 0, 0, 0.3);
      border: 2px dashed rgba(255, 60, 172, 0.3);
      border-radius: 24px; min-height: 500px;
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden; cursor: pointer; transition: 0.3s;
    }
    .preview-zone:hover { border-color: var(--pink); background: rgba(255, 60, 172, 0.05); }

    #image-preview { width: 100%; height: 100%; object-fit: cover; display: none; }
    .upload-prompt { text-align: center; color: var(--muted); padding: 20px; }
    .upload-prompt ion-icon { font-size: 60px; margin-bottom: 15px; color: var(--pink); opacity: 0.8; }

    /* ── FORM ZONE ── */
    .form-zone h1 { font-family: 'Syne', sans-serif; font-size: 32px; margin-bottom: 30px; }
    .form-zone h1 span { background: var(--grad1); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

    .input-group { margin-bottom: 22px; }
    .input-group label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 10px; color: var(--muted); }

    .custom-input {
      width: 100%; background: var(--glass); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px; padding: 14px 18px; color: #fff; font-family: inherit; font-size: 14px;
      outline: none; transition: 0.3s;
    }
    .custom-input:focus { border-color: var(--pink); background: rgba(255,255,255,0.08); box-shadow: 0 0 0 4px rgba(255, 60, 172, 0.1); }
    
    select.custom-input { cursor: pointer; appearance: none; }
    select.custom-input option { background: #111; color: #fff; }

    .publish-btn {
      width: 100%; padding: 18px; border-radius: 50px; border: none;
      background: var(--grad1); color: #fff; font-weight: 800; font-family: 'Syne', sans-serif;
      font-size: 15px; cursor: pointer; transition: 0.4s; 
      box-shadow: 0 10px 25px rgba(255, 60, 172, 0.3); margin-top: 15px;
    }
    .publish-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(255, 60, 172, 0.5); }

    input[type="file"] { display: none; }

    /* SCROLLBAR */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--pink); }

    @media (max-width: 850px) {
      .upload-card { grid-template-columns: 1fr; padding: 25px; }
      .preview-zone { min-height: 300px; }
    }
  </style>
</head>
<body>

<div class="bg-scene"><div class="bg-grid"></div></div>

<div class="container">
  <div class="upload-card">
    
    <div class="preview-zone" onclick="document.getElementById('file-input').click()">
      <div class="upload-prompt" id="prompt">
        <ion-icon name="cloud-upload-outline"></ion-icon>
        <p style="font-weight: 600; color: #fff;">Choose a high-resolution image</p>
        <p style="font-size: 13px; margin-top: 5px;">Supports: JPG, PNG, WEBP</p>
      </div>
      <img id="image-preview" src="#" alt="Preview"/>
    </div>

    <div class="form-zone">
      <h1>New <span>Inspiration</span></h1>
      
      <form action="/upload" method="POST" enctype="multipart/form-data">
        <input type="file" name="file" id="file-input" accept="image/*" required>

        <div class="input-group">
          <label>Post Title</label>
          <input type="text" name="postTitle" class="custom-input" placeholder="Give your pin a name..." required>
        </div>

        <div class="input-group">
          <label>Category</label>
          <select name="category" class="custom-input" required>
            <option value="" disabled selected>Select a category</option>
            <option value="Art & Design">Art & Design</option>
            <option value="Architecture">Architecture</option>
            <option value="Travel">Travel</option>
            <option value="Food">Food</option>
            <option value="Fashion">Fashion</option>
            <option value="Technology">Technology</option>
            <option value="Nature">Nature</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="input-group">
          <label>Description</label>
          <textarea name="filecaption" class="custom-input" rows="5" placeholder="What is this pin about?"></textarea>
        </div>

        <button type="submit" class="publish-btn">Publish Pin ✦</button>
      </form>
    </div>

  </div>
</div>

<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script>
  const fileInput = document.getElementById('file-input');
  const preview = document.getElementById('image-preview');
  const prompt = document.getElementById('prompt');

  fileInput.onchange = evt => {
    const [file] = fileInput.files;
    if (file) {
      preview.src = URL.createObjectURL(file);
      preview.style.display = 'block';
      prompt.style.display = 'none';
    }
  }
</script>

</body>
</html>