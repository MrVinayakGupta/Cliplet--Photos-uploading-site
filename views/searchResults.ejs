<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Results for "<%= query %>" | Pinspire</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Cabinet+Grotesk:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --pink: #FF3CAC; --blue: #2B86C5;
      --grad1: linear-gradient(135deg,#FF3CAC 0%,#784BA0 50%,#2B86C5 100%);
      --bg: #05050a; --glass: rgba(255,255,255,0.04); --glass-b: rgba(255,255,255,0.1);
      --text: #f0f0ff; --muted: rgba(240,240,255,0.4);
    }

    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: 'Cabinet Grotesk', sans-serif; background: var(--bg); color: var(--text); overflow-x: hidden; }

    /* ─── BACKGROUND ─── */
    .bg-scene { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: #05050a; }
    .bg-grid {
      position: absolute; inset: 0;
      background-image: linear-gradient(rgba(255,60,172,0.03) 1px, transparent 1px), 
                        linear-gradient(90deg, rgba(255,60,172,0.03) 1px, transparent 1px);
      background-size: 50px 50px;
    }

    .container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    .search-header { margin-bottom: 40px; }
    .search-header h1 { font-family: 'Syne', sans-serif; font-size: 32px; }
    .search-header span { background: var(--grad1); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

    /* ─── USER RESULTS (Horizontal) ─── */
    .section-title { font-size: 14px; text-transform: uppercase; letter-spacing: 2px; color: var(--muted); margin-bottom: 20px; }
    .user-results { display: flex; gap: 15px; overflow-x: auto; padding-bottom: 20px; scrollbar-width: none; }
    .user-card {
      min-width: 200px; background: var(--glass); border: 1px solid var(--glass-b);
      border-radius: 20px; padding: 20px; text-align: center; backdrop-filter: blur(10px);
      transition: 0.3s;
    }
    .user-card:hover { transform: translateY(-5px); border-color: var(--pink); }
    .user-ava { width: 60px; height: 60px; border-radius: 50%; margin: 0 auto 12px; background: var(--grad1); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px; overflow: hidden; }
    .user-ava img { width: 100%; height: 100%; object-fit: cover; }

    /* ─── POST RESULTS (Masonry) ─── */
    .post-grid { columns: 4; column-gap: 15px; }
    .post-card { break-inside: avoid; margin-bottom: 15px; border-radius: 15px; overflow: hidden; position: relative; background: #111; }
    .post-card img { width: 100%; display: block; transition: 0.5s; }
    .post-card:hover img { transform: scale(1.05); }
    .post-overlay { position: absolute; inset:0; background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.8)); opacity:0; transition: 0.3s; display: flex; align-items: flex-end; padding: 15px; }
    .post-card:hover .post-overlay { opacity:1; }

    @media (max-width: 900px) { .post-grid { columns: 2; } }
  </style>
</head>
<body>

<div class="bg-scene"><div class="bg-grid"></div></div>

<div class="container">
  <div class="search-header">
    <h1>Results for <span>"<%= query %>"</span></h1>
  </div>

  <% if (users && users.length > 0) { %>
    <div class="section-title">People</div>
    <div class="user-results">
      <% users.forEach(u => { %>
        <a href="/user/<%= u.username %>" style="text-decoration: none;">
          <div class="user-card">
            <div class="user-ava">
              <% if(u.dp) { %> <img src="<%= u.dp %>"> <% } else { %> <%= u.username[0].toUpperCase() %> <% } %>
            </div>
            <div style="font-weight: 700; color: #fff;"><%= u.fullName || u.username %></div>
            <div style="font-size: 12px; color: var(--muted);">@<%= u.username %></div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>

  <div class="section-title" style="margin-top: 40px;">Inspirations</div>
  <% if (posts && posts.length > 0) { %>
    <div class="post-grid">
      <% posts.forEach(p => { %>
        <div class="post-card">
          <a href="/user/<%= p.user.username %>/<%= p._id %>">
            <img src="<%= p.image %>" alt="Result">
            <div class="post-overlay">
              <p style="font-size: 13px; font-weight: 600;"><%= p.postTitle %></p>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p style="color: var(--muted); text-align: center; margin-top: 20px;">No pins found matching your search.</p>
  <% } %>
</div>

</body>
</html>